# Rust 编译输出（debug/release、依赖缓存、增量编译文件、二进制）
/target/

# IDE 配置（按需提交团队共享配置时可删除对应规则）
.idea/
.vscode/
*.swp
*.swo

# 操作系统临时文件
.DS_Store
Thumbs.db
desktop.ini

# 本地环境变量和私有配置
.env
.env.*
!.env.example

# Contains the local peer address and shared secret.
desklink.toml

# Windows 调试/发布产物（通常位于 target/，这里作为额外保护）
*.pdb
*.ilk
*.dSYM/
